{
  "name": "stokmaterial-server",
  "version": "1.0.0",
  "description": "Backend REST API untuk Sistem POS Toko Bangunan StokMaterial.id",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node src/seeders/initialSeed.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "pos",
    "building-material",
    "express",
    "sequelize",
    "postgres",
    "toko-bangunan"
  ],
  "author": "StokMaterial.id",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "verbose": true,
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/helpers/"
    ]
  }
}
