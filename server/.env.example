PORT=5000
NODE_ENV=development
JWT_SECRET=ganti-dengan-rahasia-panjang-dan-acak

# Opsional: URL Neon/PostgreSQL cloud. Jika kosong, dipakai PostgreSQL lokal di bawah.
NEON_DATABASE_URL=

# PostgreSQL lokal. docker-compose memetakan Postgres ke port 1000 di host.
DB_HOST=127.0.0.1
DB_PORT=1000
DB_USER=postgres
DB_PASS=admin
DB_NAME=stokmaterial_db

# Database khusus test (dibuat otomatis oleh npm test)
DB_NAME_TEST=stokmaterial_test_db
